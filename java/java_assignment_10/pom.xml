<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>roman-numeral-converter</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            JUnit 5. junit-jupiter also brings in junit-jupiter-params, which the
            provided tests need for @ParameterizedTest, @CsvSource and @ValueSource.
            The scope is the default (compile) instead of "test", because the test
            file sits in the same folder as RomanNumeralConverter.java.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
        </dependency>
    </dependencies>

    <build>
        <!--
            Flat layout: read the .java files straight from this folder
            (next to pom.xml) instead of src/main/java and src/test/java.
        -->
        <sourceDirectory>${project.basedir}</sourceDirectory>

        <plugins>
            <!-- Only compile .java files in this folder itself, not in subfolders such as target/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <includes>
                        <include>*.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!--
                Surefire runs the JUnit 5 tests on "mvn test". Because the test
                class is compiled with the main code, point it at that output folder.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>